RELAY_LISTEN=:8080
RELAY_DB_PATH=/data/relay.db
RELAY_LOG_LEVEL=info

# invite (default) | open | closed
RELAY_ENROLLMENT=invite
# Set to the CIDR of your TLS proxy so per-IP enrollment limits see real client addresses.
#RELAY_TRUSTED_PROXIES=172.16.0.0/12

# One app per white-label build. Secrets: inline value or the _FILE variant.
RELAY_APP_1_ID=org.openbekci.app
RELAY_APP_1_FCM_CREDENTIALS_FILE=/run/secrets/fcm_service_account
RELAY_APP_1_APNS_KEY_FILE=/run/secrets/apns_key
RELAY_APP_1_APNS_KEY_ID=ABC123DEFG
RELAY_APP_1_APNS_TEAM_ID=TEAM123456
RELAY_APP_1_APNS_TOPIC=org.openbekci.app
#RELAY_APP_1_APNS_SANDBOX=true

# Optional bearer token required on /metrics.
#RELAY_METRICS_TOKEN_FILE=/run/secrets/metrics_token
